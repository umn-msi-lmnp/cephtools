#%Module#######################################################################

# Find the current cephtools root path, from the dirname that this file is located in
set cephtools_root [file dirname [file normalize [module-info name]]]

prepend-path PATH "${cephtools_root}/bin"
# This will export bash functions into the current shell, so cephtools tab-completion works
source-sh bash "${cephtools_root}/share/bash-completion/completions/cephtools"
